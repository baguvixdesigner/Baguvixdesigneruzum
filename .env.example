# --- Telegram ---
BOT_TOKEN=
# telegram_id администратора (Карим) — получает уведомления о пополнениях и предложенных категориях
ADMIN_TELEGRAM_ID=
# личный @username для кнопки "Поддержка" (без @)
SUPPORT_USERNAME=

# --- База данных ---
# Prisma / PostgreSQL. Для локальной разработки см. docker-compose.yml
DATABASE_URL="postgresql://uzum_bot:uzum_bot@localhost:5432/uzum_bot?schema=public"

# --- Oxylabs E-Commerce Scraper API (Taobao + 1688, общая подписка) ---
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# --- Uzum (неофициальные внутренние эндпоинты) ---
# домены из первой версии ТЗ (umarket.uz) больше не резолвятся, актуальный
# бренд-домен подтверждён вручную — uzum.uz (см. README, раздел про Uzum API)
UZUM_GRAPHQL_URL=https://graphql.uzum.uz/
UZUM_API_URL=https://api.uzum.uz/

# --- Резерв: Apify Uzum Scraper (используется, если прямые эндпоинты Uzum нестабильны) ---
APIFY_TOKEN=
APIFY_UZUM_ACTOR_ID=

# --- Курс валют ЦБ РУз ---
CBU_RATES_URL=https://cbu.uz/ru/arkhiv-kursov-valyut/json/

# --- Перевод названий товаров на русский ---
# провайдер: "google-unofficial" (без ключа, по умолчанию) | "yandex" (нужен YANDEX_TRANSLATE_API_KEY)
TRANSLATE_PROVIDER=google-unofficial
YANDEX_TRANSLATE_API_KEY=

# --- Реквизиты для пополнения кошелька (карта) ---
TOPUP_CARD_NUMBER=0000 0000 0000 0000
TOPUP_CARD_HOLDER=Karim K.

# --- Бизнес-правила ---
QUERY_PRICE_SUM=14900
MIN_TOPUP_SUM=50000
CACHE_TTL_HOURS=24
